# ==============================================================================
# Environment variables & secrets management
# rag99 Monorepo Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env, api/.env, and web/.env.
# NEVER commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# Server Configuration & Ports
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Secrets (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/rag99?sslmode=require&connect_timeout=30

# Authentication & Security Secrets (JWT_SECRET must be >= 32 characters)
JWT_SECRET=replace_with_a_cryptographically_secure_random_secret_32_chars_minimum
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Polyglot Persistence (MongoDB Atlas Connection URI)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/rag99?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/rag99?retryWrites=true&w=majority

# Distributed Caching (Redis)
REDIS_URL=redis://localhost:6379

# AI Provider Credentials & Configuration
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-openrouter-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
AI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1024

# Cloudinary Object Storage Secrets
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Server Upload & Rate Limiting Thresholds
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional High-Availability Fallback AI Keys
GROQ_API_KEY=
OPENROUTER_API_KEY1=
OPENROUTER_API_KEY2=
OPENROUTER_API_KEY3=
