# ==============================================================================
# rag99 Environment Variables & Secrets Management
# ==============================================================================
# Copy this file to .env (or api/.env and web/.env) and populate the values.
# NEVER commit actual secrets, keys, or passwords to version control.
# ==============================================================================

# --- Database & Storage Secrets ---
DATABASE_URL="postgresql://user:password@localhost:5432/rag99?sslmode=require&connect_timeout=30"
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/rag99?retryWrites=true&w=majority"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- Security & Auth Secrets ---
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-32-chars-minimum"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# --- AI Provider API Keys ---
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY="your-openrouter-api-key"
AI_CHAT_MODEL="meta-llama/llama-3.3-70b-instruct"
AI_EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMENSION=1024
GROQ_API_KEY="your-groq-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_API_KEY1="your-extra-openrouter-key-1"
OPENROUTER_API_KEY2="your-extra-openrouter-key-2"
OPENROUTER_API_KEY3="your-extra-openrouter-key-3"

# --- Server & Networking ---
PORT=4000
CORS_ORIGIN="http://localhost:3000,https://rag99.vercel.app"
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Frontend Web Variables ---
NEXT_PUBLIC_API_URL="https://rag99-api.onrender.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
