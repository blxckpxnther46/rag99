# ==============================================================================
# Environment Variables & Secrets Management (Backend API)
# ==============================================================================
# Never commit actual credentials, secrets, or keys to version control.
# Copy this file to .env and configure real values.
# ==============================================================================

# Database Secrets
DATABASE_URL="postgresql://user:password@localhost:5432/rag99?sslmode=require&connect_timeout=30"

# Polyglot Persistence (MongoDB Atlas Connection URI)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/rag99?retryWrites=true&w=majority"

# Redis Distributed Cache URL (Optional)
REDIS_URL="redis://localhost:6379"

# Security & Authentication Secrets (JWT_SECRET must be at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
GOOGLE_CLIENT_ID="replace-with-google-client-id.apps.googleusercontent.com"

# AI Provider Credentials & Model Configuration
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY="replace-with-openrouter-api-key"
AI_CHAT_MODEL="meta-llama/llama-3.3-70b-instruct"
AI_EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMENSION="1024"

# Cloudinary Storage Secrets
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

# Server & Network Configuration
PORT="4000"
CORS_ORIGIN="http://localhost:3000,https://rag99.vercel.app"
MAX_UPLOAD_MB="10"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"

# Multi-Provider AI Rotation Pool
GROQ_API_KEY="replace-with-groq-api-key"
OPENROUTER_API_KEY="replace-with-openrouter-api-key"
OPENROUTER_API_KEY1="replace-with-openrouter-api-key-1"
OPENROUTER_API_KEY2="replace-with-openrouter-api-key-2"
OPENROUTER_API_KEY3="replace-with-openrouter-api-key-3"
